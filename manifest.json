{
  "manifest_version": 3,
  "name": "Reader+",
  "version": "1.0",
  "description": "A minimal reader view.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Reader+", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
