{
  "manifest_version": 3,
  "name": "Reader+",
  "version": "1.3",
  "description": "A minimal reader view.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "dark": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Toggle dark mode on the page" }
  },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["dark.js"], "run_at": "document_start" }],
  "action": { "default_title": "Reader+", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
